# Copy to .env (or run `make`, which does it for you and fills in the secrets).
# Everything in this file is read by compose.yaml and provision.py.

# ---- host ----------------------------------------------------------------
TZ=Europe/Zurich
# `id -u` / `id -g` of the user that owns DATA_ROOT. Files are written as this.
PUID=1000
PGID=1000
# Single tree holding torrents/ and media/. Must be ONE filesystem for hardlinks.
# Point this at your big disk (e.g. /srv/media) once you have one; `make` creates it.
DATA_ROOT=./data
# gid of the host `render` group, for Intel Quick Sync. `make` autodetects it.
RENDER_GID=993
# iHD for Gen8 (Broadwell, 2014) and newer; i965 for Haswell and older.
LIBVA_DRIVER_NAME=iHD

# ---- Jellyfin ------------------------------------------------------------
# The URL clients outside the host use. Wrong value breaks remote playback.
JELLYFIN_PUBLISHED_URL=http://nuc.local:8096
JELLYFIN_ADMIN_USER=admin
# What clients show in the server list. Jellyfin otherwise uses the container's
# hostname, so you get a hex blob like "01428036365f".
JELLYFIN_SERVER_NAME="Home Cinema"
# Metadata language/region, used for the scriptable setup wizard.
JELLYFIN_LANG=en
JELLYFIN_COUNTRY=CH
# none | qsv | vaapi   (qsv = Intel Quick Sync, what a NUC wants)
HWACCEL=qsv

# ---- Seerr ---------------------------------------------------------------
# Owner account Seerr creates for itself; it signs in against Jellyfin, so the
# password is the Jellyfin admin's. Only the email is Seerr's own.
SEERR_EMAIL=admin@localhost
SEERR_PUBLIC_URL=http://nuc.local:5055

# ---- VPN (qBittorrent only) ---------------------------------------------
# Public trackers publish your IP to every peer in the swarm. Turning this on
# routes qBittorrent through Gluetun with a killswitch: if the tunnel drops,
# traffic is dropped instead of leaking. Nothing else is tunnelled - Prowlarr
# only searches, and Jellyfin has to stay reachable on your LAN.
#
# Set to true, fill in the four values below, then `make`.
VPN_ENABLED=false
# Any provider Gluetun supports: mullvad, protonvpn, nordvpn, airvpn, ivpn,
# surfshark, windscribe, ... or `custom` with your own WireGuard config.
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
# Comma separated, no spaces. Exit countries; closer is faster.
VPN_COUNTRIES=Switzerland
# Inbound connections are the difference between a trickle and full speed, and a
# VPN blocks them unless the provider forwards a port. Only ProtonVPN, Private
# Internet Access, PrivateVPN and Perfect Privacy support it; `on` with any other
# provider just fails. Gluetun pushes the port into qBittorrent itself.
VPN_PORT_FORWARDING=off
# Subnet the compose network lives on, so Sonarr/Radarr can reach qBittorrent
# through the tunnel namespace. Docker's default pool; widen if yours differs.
DOCKER_SUBNET=172.16.0.0/12

# ---- reverse proxy -------------------------------------------------------
# Hostnames instead of port numbers: jellyfin.home, requests.home, radarr.home
# ... all on port 80. The direct ports stay published, so this is additive and
# the LAN fast path is untouched - if the proxy is ever in the way, use the port.
#
# A proxy does NOT give you name resolution. Something still has to map these
# names to this machine's IP; see "Reverse proxy and DNS" in the README for the
# three ways, from one hosts file to a wildcard DNS record.
PROXY_ENABLED=false
PROXY_DOMAIN=home
# Change only if something already owns port 80 on the host.
PROXY_HTTP_PORT=80
# With the VPN on, qBittorrent has no network of its own, so the proxy must
# reach it inside Gluetun. Set this to `gluetun` if you run VPN + proxy together,
# otherwise qbit.<domain> returns 502 (the direct port still works either way).
QBITTORRENT_HOST=qbittorrent

# ---- auth on the admin apps ---------------------------------------------
# Sonarr/Radarr/Prowlarr. External + DisabledForLocalAddresses = no login
# prompt from the LAN, which is what makes this zero-click.
#
# SECURITY: this leaves those three apps open to anyone on your network. If the
# NUC is on an untrusted LAN, or you port-forward it, set:
#   ARR_AUTH_METHOD=Forms
#   ARR_AUTH_REQUIRED=Enabled
# and create a user in each app once (that part cannot be seeded).
ARR_AUTH_METHOD=External
ARR_AUTH_REQUIRED=DisabledForLocalAddresses

# Which hostnames Sonarr/Radarr/Prowlarr will answer to. Comma separated, no
# spaces. Left EMPTY on purpose: empty means "answer to anything", which is only
# a health warning, while a wrong value makes the app reject your browser with
# "Invalid Host" and there is no way in but editing this back.
#
# To silence the warning, list every name you actually use, e.g.
#   ARR_ALLOWED_HOSTS=localhost,127.0.0.1,nuc.local,192.168.1.50
# then `make up`. It is hardening against DNS-rebinding from a browser on your
# LAN; on a trusted home network the warning is fair to ignore.
ARR_ALLOWED_HOSTS=

# Qualities Sonarr/Radarr must never grab, comma separated, using their exact
# names from the quality profile. Remux ships ENABLED in HD-1080p and outscores
# everything else, so a 1080p film arrives as a 25-40 GB Blu-ray remux. Excluded,
# the same film comes as a 2-12 GB encode: minutes instead of hours, and it
# streams fine. Clear this if you want remuxes and have the disk and bandwidth.
ARR_EXCLUDE_QUALITIES=Remux-1080p,Remux-2160p,BR-DISK,Raw-HD

# Release size floor and ceiling for the 1080p qualities, in MB per minute.
# 1 MB/min = 0.133 Mb/s, so 25-150 is roughly 3.3-20 Mb/s.
#
# The floor matters as much as excluding Remux. Every quality ships with a
# minimum of 0, so a 1.7 GB "x265" encode of a 106 minute film - 2.2 Mb/s, where
# watchable 1080p starts around 6 - counts as Bluray-1080p and wins on size. It
# plays fine and looks like mud. The ceiling keeps a single film under ~15 GB.
ARR_MIN_MB_PER_MIN=25
ARR_MAX_MB_PER_MIN=150

# The same for SERIES, which needs its own window. The limit is applied per
# minute, per EPISODE, so reusing the movie numbers is wrong at both ends:
# 150 MB/min waves through a 3.3 GB/episode Blu-ray season pack - 72 GB for one
# season of a 43 minute show - while the 25 floor rejects the ~700 MB x265
# WEB-DL episode you actually want. 8-30 MB/min is about 1-4 Mb/s: 340 MB to
# 1.26 GiB per 43 minute episode, so 7-28 GB per 22-episode season, at a
# quality you will not tell apart on a TV.
TV_MIN_MB_PER_MIN=4
TV_MAX_MB_PER_MIN=30

# ---- ports ---------------------------------------------------------------
JELLYFIN_PORT=8096
JELLYFIN_DISCOVERY_PORT=7359
SEERR_PORT=5055
PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878
QBITTORRENT_PORT=8080
BT_PORT=6881

# ---- image tags ----------------------------------------------------------
# Pinned on purpose: `latest` turns a reboot into a surprise upgrade.
JELLYFIN_TAG=12.3
SEERR_TAG=v3.5.1
PROWLARR_TAG=latest
SONARR_TAG=4.0.20
RADARR_TAG=6.4.4
QBITTORRENT_TAG=5.3.0
FLARESOLVERR_TAG=v3.5.2
GLUETUN_TAG=v3.41.3
CADDY_TAG=2.11.7-alpine

# ---- secrets -------------------------------------------------------------
# Left blank here. `make` generates them once into .env and never touches them
# again. Changing one later means re-provisioning that service.
PROWLARR_API_KEY=
SONARR_API_KEY=
RADARR_API_KEY=
SEERR_API_KEY=
JELLYFIN_ADMIN_PASS=
QBITTORRENT_PASS=
